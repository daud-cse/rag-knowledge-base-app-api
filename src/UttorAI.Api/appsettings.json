{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=UttorAI;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "VectorStore": {
    "Provider": "Qdrant",
    "Qdrant": {
      "Url": "http://localhost:6333",
      "ApiKey": "",
      "Collection": "uttorai_chunks"
    }
  },

  "Jwt": {
    "Issuer": "uttor-ai",
    "Audience": "uttor-ai-ui",
    "SigningKey": "",
    "ExpiryMinutes": 480
  },

  "Cors": {
    "Origins": [ "http://localhost:4300", "http://localhost:4200" ]
  },

  "Storage": {
    "Provider": "AzureBlob",
    "LocalRoot": "",
    "Azure": {
      "ConnectionString": "",
      "AccountName": "uttorai",
      "ContainerStrategy": "PerTenant",
      "Container": "uttorai-documents"
    }
  },

  "Llm": {
    "Provider": "Local",
    "ApiKey": "",
    "Endpoint": "https://api.openai.com/v1",
    "ChatModel": "gpt-4o-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "ApiVersion": "2024-08-01-preview",
    "ChatDeployment": "",
    "EmbeddingDeployment": "",
    "PromptCostPer1K": 0.00015,
    "CompletionCostPer1K": 0.0006
  },

  "GoogleAuth": {
    "ClientId": "461216527367-drqnprkj96t4bjigg3ambbdl5vpv6fbv.apps.googleusercontent.com"
  },

  "MicrosoftAuth": {
    "TenantId": "",
    "ClientId": ""
  },

  "Authentication": {
    "EntraId": {
      "TenantId": "",
      "ClientId": ""
    },
    "Google": {
      "ClientId": ""
    },
    "Saml": {
      "EntityId": ""
    },
    "AutoProvision": true,
    "AutoProvisionRole": "User",
    "AllowIndividualSignup": true,
    "AllowCompanySignup": true
  }
}
